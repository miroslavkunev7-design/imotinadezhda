{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "ignoreCommand": "exit 1",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/mobile/crm/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/crm",
      "destination": "/mobile/crm/crm-nachalo.html"
    },
    {
      "source": "/crm/",
      "destination": "/mobile/crm/crm-nachalo.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|opera mini|iemobile|mobile safari).*"
        }
      ],
      "destination": "/mobile/home.html"
    },
    {
      "source": "/",
      "destination": "/desktop-home.html"
    },
    {
      "source": "/index.html",
      "destination": "/desktop-home.html"
    }
  ],
  "functions": {
    "api/collect.js": {
      "maxDuration": 60
    },
    "api/assistant.js": {
      "maxDuration": 60
    },
    "api/scan.js": {
      "maxDuration": 60
    },
    "api/tts.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/desktop.html",
      "destination": "/",
      "permanent": false
    }
  ]
}