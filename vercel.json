{
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "ignoreCommand": "exit 1",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/mobile/crm/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/mobile/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|woff2|mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/plan/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/pano/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/model/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/mobile/crm/assets/app-icon3-round-192.png"
    },
    {
      "source": "/f/:file",
      "destination": "/api/tools?file=:file"
    },
    {
      "source": "/plan/:scope/:id",
      "destination": "/api/tools?plan=:scope/:id"
    },
    {
      "source": "/pano/:unit/:n",
      "destination": "/api/tools?pano=:unit/:n"
    },
    {
      "source": "/model/:building/poster",
      "destination": "/api/tools?model=:building/poster"
    },
    {
      "source": "/model/:building",
      "destination": "/api/tools?model=:building"
    },
    {
      "source": "/api/tts",
      "destination": "/api/voice?fn=tts"
    },
    {
      "source": "/api/transcribe",
      "destination": "/api/voice?fn=transcribe"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.*mobile|windows phone|blackberry|opera mini|iemobile|mobile safari).*"
        }
      ],
      "destination": "/mobile/home.html"
    },
    {
      "source": "/",
      "destination": "/desktop-home.html"
    },
    {
      "source": "/index.html",
      "destination": "/desktop-home.html"
    }
  ],
  "functions": {
    "api/collect.js": {
      "maxDuration": 60,
      "includeFiles": "api/_vendor/**"
    },
    "api/assistant.js": {
      "maxDuration": 300
    },
    "api/scan.js": {
      "maxDuration": 60
    },
    "api/tools.js": {
      "maxDuration": 60,
      "includeFiles": "api/_vendor/**"
    },
    "api/email.js": {
      "maxDuration": 60,
      "includeFiles": "api/_vendor/**"
    },
    "api/video.js": {
      "maxDuration": 60,
      "includeFiles": "api/_vendor/jpeg-js/**"
    },
    "api/apply.js": {
      "maxDuration": 60
    },
    "api/push.js": {
      "maxDuration": 30
    },
    "api/voice.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/crm",
      "destination": "/mobile/crm/crm-nachalo.html",
      "permanent": false
    },
    {
      "source": "/crm/",
      "destination": "/mobile/crm/crm-nachalo.html",
      "permanent": false
    },
    {
      "source": "/desktop.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
