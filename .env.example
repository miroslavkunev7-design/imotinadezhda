# ============================================================
# ИМОТИ НАДЕЖДА — Environment Variables
# Копирай този файл като .env (локално) или добави всяка променлива
# във Vercel: Project → Settings → Environment Variables
# (Production + Preview).
# ============================================================

# ============================================================
# SUPABASE (ЗАДЪЛЖИТЕЛНИ)
# ============================================================
# Взимат се от: https://supabase.com/dashboard
#   → твоя проект → Settings → API

# Публичен URL на Supabase проекта (пример: https://xxxx.supabase.co)
SUPABASE_URL="https://<your-project>.supabase.co"
VITE_SUPABASE_URL="https://<your-project>.supabase.co"

# Publishable / anon key — публичен, безопасен за frontend.
# В Supabase Dashboard: Settings → API → "Project API keys" → anon / public
SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Project ID — само буквено-цифровата част от URL-а (преди .supabase.co)
SUPABASE_PROJECT_ID="<project-id>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# Service role key — ТАЙНА! Само за сървър (Edge Functions, server code).
# НИКОГА не я слагай с VITE_ префикс и не я публикувай в frontend/GitHub.
# Взима се от: Settings → API → Project API keys → service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ============================================================
# AI (поне един провайдър за AI асистента + чата с клиенти)
# ============================================================
# Приоритет в src/lib/ai-provider.ts:
#   1. Vercel AI Gateway  2. OpenAI  3. Gemini  4. Lovable Gateway
# Достатъчно е да зададеш САМО ЕДИН. LOVABLE_API_KEY се вкарва
# автоматично в Lovable средата.

# Опция A — Vercel AI Gateway (препоръчано ако си на Vercel Pro)
# AI_GATEWAY_KEY=""
# AI_GATEWAY_MODEL="openai/gpt-4o-mini"

# Опция B — OpenAI директно (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Опция C — Google Gemini директно (най-евтин)
# https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"

# Опция D — Lovable Gateway (auto-set в Lovable, работи и на Vercel)
# Взима се от: Lovable Dashboard → Project → Secrets → LOVABLE_API_KEY
# LOVABLE_API_KEY=""
# LOVABLE_MODEL="google/gemini-2.5-flash"

# ============================================================
# PUSH NOTIFICATIONS (VAPID)
# ============================================================
# Генерират се веднъж локално с:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@imotinadezhda.bg"

# ============================================================
# EMAIL (опционално — за маркетинг / нотификации)
# ============================================================
# Взима се от: https://resend.com/api-keys
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@imotinadezhda.bg"
# MARKETING_FROM_EMAIL="marketing@imotinadezhda.bg"

# ============================================================
# SCRAPER (опционално — imot.bg / bazar.bg извличане)
# ============================================================
# Взима се от: https://firecrawl.dev/app/api-keys
# FIRECRAWL_API_KEY=""

# ============================================================
# SITE / MEDIA
# ============================================================
VITE_SITE_URL="https://imotinadezhda.bg"
# Ако не е зададен, медиата се сервира през /media/* rewrite в vercel.json
# VITE_ASSET_BASE_URL="https://cdn.imotinadezhda.bg"