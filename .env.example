# ============================================================
# Copy these into Vercel → Project → Settings → Environment Variables
# (Production + Preview). Values come from Lovable Cloud → Backend.
# ============================================================

# --- Client (exposed to browser, prefixed with VITE_) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server (used by createServerFn / SSR, never exposed) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-ref

# --- Lovable AI Gateway (provisioned automatically on Lovable;
#     paste the value from Lovable → Settings → Secrets when on Vercel) ---
LOVABLE_API_KEY=your-lovable-api-key
