{
  "name": "imoti-nadezhda-settings",
  "productName": "Imoti Nadezhda Settings",
  "version": "1.0.0",
  "description": "Windows Settings companion for Imoti Nadezhda live site CMS",
  "main": "electron/main.js",
  "author": "Imoti Nadezhda",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5179 && electron .\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-builder --win portable nsis --x64",
    "build:dir": "npm run build:renderer && electron-builder --win dir --x64",
    "pack:artifacts": "node scripts/copy-artifacts.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "bg.imotinadezhda.settings",
    "productName": "Imoti Nadezhda Settings",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ImotiNadezhda-Settings-${version}-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "en_US",
        "bg_BG"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Imoti Nadezhda Settings",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "ImotiNadezhda-Settings-${version}-portable.${ext}"
    }
  }
}
